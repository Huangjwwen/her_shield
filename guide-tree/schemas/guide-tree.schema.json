{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "her-shield/guide-tree.schema.json",
  "title": "Her Shield guide tree",
  "type": "object",
  "required": ["schemaVersion", "treeId", "treeVersion", "status", "startNodeId", "nodes", "terminals"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "treeId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "treeVersion": { "type": "string" },
    "conditionIndexVersion": { "type": "string" },
    "status": { "enum": ["draft", "reviewing", "published", "retired"] },
    "startNodeId": { "type": "string" },
    "nodes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/node" } },
    "terminals": { "type": "object", "additionalProperties": { "$ref": "#/$defs/terminal" } }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "type", "title", "answerKey", "options"],
      "properties": {
        "id": { "type": "string" },
        "type": { "enum": ["single", "multi"] },
        "title": { "type": "string" },
        "answerKey": { "type": "string" },
        "preRules": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
        "options": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/option" } }
      }
    },
    "option": {
      "type": "object",
      "required": ["label", "value"],
      "properties": {
        "label": { "type": "string" },
        "value": { "type": "string" },
        "next": { "type": "string" },
        "terminal": { "type": "string" },
        "setFlags": { "type": "array", "items": { "type": "string" } },
        "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } }
      },
      "anyOf": [{ "required": ["next"] }, { "required": ["terminal"] }, { "required": ["rules"] }]
    },
    "rule": {
      "type": "object",
      "properties": {
        "when": { "type": "object" },
        "otherwise": { "const": true },
        "next": { "type": "string" },
        "terminal": { "type": "string" }
      },
      "anyOf": [{ "required": ["next"] }, { "required": ["terminal"] }]
    },
    "terminal": {
      "type": "object",
      "required": ["id", "title", "scopeStatus"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "scopeStatus": { "enum": ["in_scope", "out_of_scope"] }
      }
    }
  }
}
