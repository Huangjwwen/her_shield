          "value": "state_or_police",
          "terminal": "HD",
          "setFlags": [
            "external_state_route"
          ]
        },
        {
          "label": "了解民事诉讼或人格权救济",
          "value": "civil_consultation",
          "terminal": "HD",
          "setFlags": [
            "civil_route"
          ]
        }
      ]
    },
    "H5": {
      "id": "H5",
      "type": "single",
