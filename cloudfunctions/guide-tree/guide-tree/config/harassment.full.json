        {
          "label": "没有明确渠道",
          "value": "no_clear_channel",
          "next": "H7"
        },
        {
          "label": "已投诉但公司不处理",
          "value": "complained_no_action",
          "terminal": "HD"
        }
      ]
    },
    "H7": {
      "id": "H7",
      "type": "multi",
