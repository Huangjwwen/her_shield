        {
          "label": "存在",
          "value": "immediate_risk",
          "terminal": "HC"
        },
        {
          "label": "暂时安全",
          "value": "safe_now",
          "next": "H4"
        }
      ]
    },
    "H4": {
      "id": "H4",
      "type": "single",
