          "value": "verbal_jokes",
          "next": "H2"
        },
        {
          "label": "文字图片或聊天骚扰",
          "value": "text_image_chat",
          "next": "H2"
        },
        {
          "label": "肢体接触",
          "value": "physical_contact",
          "next": "H3"
        },
        {
          "label": "以转正/晋升/考核交换性要求",
          "value": "quid_pro_quo",
          "next": "H3"
        },
        {
          "label": "跟踪威胁",
          "value": "stalking_threat",
          "next": "H3"
        }
      ]
    },
    "H2": {
      "id": "H2",
      "type": "single",
