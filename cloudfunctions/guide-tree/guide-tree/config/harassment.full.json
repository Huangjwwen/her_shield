        {
          "label": "聊天/图片",
          "value": "chat_image"
        },
        {
          "label": "录音录像",
          "value": "audio_video"
        },
        {
          "label": "证人",
          "value": "witness"
        },
        {
          "label": "事后及时记录",
          "value": "contemporaneous_note"
        },
        {
          "label": "暂无",
          "value": "none",
          "setFlags": [
            "evidence_weak"
          ]
