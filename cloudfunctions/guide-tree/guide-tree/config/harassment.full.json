          "value": "rejected_but_continues",
          "next": "H4"
        },
        {
          "label": "表达不适后仍继续",
          "value": "discomfort_ignored",
          "next": "H4"
        },
        {
          "label": "尚未表达",
          "value": "not_expressed",
          "next": "H5"
        }
      ]
    },
    "H3": {
      "id": "H3",
      "type": "single",
      "title": "现在是否存在紧急人身安全风险？",
