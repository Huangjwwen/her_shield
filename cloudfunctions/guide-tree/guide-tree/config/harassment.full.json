        {
          "label": "先固定证据",
          "value": "preserve_evidence",
          "terminal": "HA"
        },
        {
          "label": "正式投诉",
          "value": "formal_complaint",
          "next": "H6"
        },
        {
          "label": "需要拒绝表达",
          "value": "rejection_script",
          "terminal": "HA"
