  "startNodeId": "P1",
  "scope": ["gender_discrimination", "pregnancy_discrimination"],
  "nodes": {
    "P1": { "id": "P1", "type": "single", "title": "你现在遇到的是哪类问题？", "answerKey": "caseType", "options": [{ "label": "孕期、产期或哺乳期被调岗、降薪或取消待遇", "value": "pregnancy_pay_cut", "next": "P2" }, { "label": "其他问题", "value": "other", "terminal": "OOS" }] },
    "P2": { "id": "P2", "type": "single", "title": "你目前和单位的关系是？", "answerKey": "relationStatus", "options": [{ "label": "仍在职", "value": "employed", "next": "P3" }, { "label": "因孕产问题已离职", "value": "left_due_to_pregnancy", "next": "P4" }, { "label": "因孕产问题被口头辞退但没办离职", "value": "oral_dismissal_related", "next": "P4" }, { "label": "因孕产问题已收到解除通知", "value": "termination_notice_related", "next": "P4" }, { "label": "不确定解除是否与孕产有关", "value": "relation_uncertain", "setFlags": ["relation_uncertain"], "next": "P4" }, { "label": "明确确认与孕产、性别或婚育无关", "value": "confirmed_unrelated", "terminal": "OOS" }] },
    "P3": { "id": "P3", "type": "single", "title": "公司是否已经发过调岗、降薪或取消待遇的通知？", "answerKey": "noticeType", "options": [{ "label": "有书面通知", "value": "written", "next": "P4" }, { "label": "只有口头通知", "value": "oral", "next": "P4" }, { "label": "还没有正式通知但已暗示", "value": "implied", "next": "P3A" }] },
    "P3A": { "id": "P3A", "type": "single", "title": "公司暗示的具体内容是什么？", "answerKey": "hintType", "options": [{ "label": "明确将调岗、降薪或取消待遇", "value": "action_hinted", "setFlags": ["anticipated_action"], "next": "P4" }, { "label": "明确要求辞职或暗示离开", "value": "exit_hinted", "setFlags": ["anticipated_exit"], "next": "P4" }, { "label": "只说可能调整但没有具体安排", "value": "vague", "terminal": "PE" }, { "label": "只有态度变化或边缘化感受", "value": "attitude_only", "terminal": "PE" }] },
    "P4": { "id": "P4", "type": "single", "title": "这件事是否可能仍在劳动仲裁一般时效内？", "answerKey": "limitationStatus", "options": [{ "label": "措施尚未实施", "value": "not_started", "rules": [{ "when": { "field": "flags", "op": "contains", "value": { "node": "P3A", "flag": "anticipated_exit" } }, "terminal": "PF" }, { "otherwise": true, "terminal": "PE" }] }, { "label": "可能在一年内", "value": "within_one_year", "next": "P5" }, { "label": "不确定", "value": "uncertain", "setFlags": ["time_uncertain"], "next": "P5" }, { "label": "可能超过一年", "value": "over_one_year", "setFlags": ["time_risk"], "next": "P5" }] },
    "P5": { "id": "P5", "type": "single", "title": "你现在处于哪个阶段？", "answerKey": "pregnancyStage", "options": [{ "label": "孕期", "value": "pregnancy", "next": "P6" }, { "label": "产假中", "value": "maternity_leave", "next": "P6" }, { "label": "哺乳期", "value": "lactation", "next": "P6" }, { "label": "不确定", "value": "uncertain", "next": "P6" }] },
    "P6": { "id": "P6", "type": "single", "title": "公司已经实际采取了什么行为？", "answerKey": "employerAction", "options": [{ "label": "仅调岗", "value": "transfer_only", "next": "P7" }, { "label": "仅降薪或扣绩效", "value": "salary_reduced", "next": "P7" }, { "label": "调岗并降薪", "value": "both", "next": "P7" }, { "label": "要求主动辞职", "value": "exit_requested", "next": "P8" }, { "label": "解除劳动合同", "value": "terminated", "next": "P8" }, { "label": "无法判断是否与孕产有关", "value": "relation_uncertain", "setFlags": ["relation_uncertain"], "next": "P9" }] },
    "P7": { "id": "P7", "type": "single", "title": "是否影响待遇、岗位级别、劳动强度、身体安全或职业发展？", "answerKey": "impact", "options": [{ "label": "工资、奖金或福利降低", "value": "salary_benefit_reduced", "next": "P8" }, { "label": "岗位降级、边缘化或发展受限", "value": "demotion_marginalization", "next": "P8" }, { "label": "增加不适合孕产状态的劳动", "value": "unsafe_work", "next": "P8" }, { "label": "通勤或工作条件明显变差", "value": "worse_conditions", "next": "P8" }, { "label": "均无明显变化", "value": "no_obvious_change", "setFlags": ["harm_low"], "next": "P8" }] },
    "P8": { "id": "P8", "type": "single", "title": "是否签过离职、调岗、降薪或协商解除文件？", "answerKey": "documentStatus", "options": [{ "label": "没签", "value": "unsigned", "next": "P9" }, { "label": "已签但不情愿", "value": "signed_under_pressure", "setFlags": ["signed_under_pressure"], "next": "P9" }, { "label": "主动提交过辞职", "value": "voluntary_resignation_submitted", "setFlags": ["voluntary_resignation_submitted"], "next": "P9" }, { "label": "不确定文件内容", "value": "document_uncertain", "setFlags": ["document_uncertain"], "next": "P9" }] },
    "P9": { "id": "P9", "type": "multi", "title": "你手上有哪些证据？", "answerKey": "evidence", "options": [{ "label": "聊天或邮件", "value": "chat_email" }, { "label": "工资流水", "value": "payroll" }, { "label": "孕产证明", "value": "pregnancy_record" }, { "label": "劳动合同或岗位说明", "value": "contract_job_description" }, { "label": "考勤", "value": "attendance" }, { "label": "暂时没有", "value": "none", "setFlags": ["evidence_weak"] }], "next": "P10", "exclusiveOptionValues": ["none"] },
    "P10": { "id": "P10", "type": "single", "title": "你已经采取过什么行动？", "answerKey": "actionStage", "preRules": [{ "when": { "field": "answers.P10", "op": "eq", "value": "arbitration_started" }, "terminal": "PD" }, { "when": { "all": [{ "field": "answers.P10", "op": "neq", "value": "arbitration_started" }, { "any": [{ "field": "answers.P2", "op": "in", "value": ["left_due_to_pregnancy", "oral_dismissal_related", "termination_notice_related", "relation_uncertain"] }, { "field": "answers.P6", "op": "in", "value": ["exit_requested", "terminated"] }, { "field": "answers.P8", "op": "eq", "value": "voluntary_resignation_submitted" }, { "field": "flags", "op": "contains", "value": { "node": "P3A", "flag": "anticipated_exit" } }] }] }, "terminal": "PF" }], "options": [{ "label": "还没有正式行动", "value": "none", "rules": [{ "when": { "field": "flags", "op": "contains", "value": { "node": "P4", "flag": "time_risk" } }, "terminal": "PC" }, { "when": { "field": "flags", "op": "containsAny", "value": [{ "node": "P8", "flag": "signed_under_pressure" }, { "node": "P8", "flag": "document_uncertain" }] }, "terminal": "PB" }, { "otherwise": true, "terminal": "PA" }] }, { "label": "只进行过口头沟通", "value": "oral_communication", "setFlags": ["need_written_record"], "rules": [{ "when": { "field": "flags", "op": "contains", "value": { "node": "P4", "flag": "time_risk" } }, "terminal": "PC" }, { "when": { "field": "flags", "op": "containsAny", "value": [{ "node": "P8", "flag": "signed_under_pressure" }, { "node": "P8", "flag": "document_uncertain" }] }, "terminal": "PB" }, { "otherwise": true, "terminal": "PA" }] }, { "label": "已内部书面投诉", "value": "internal_written_complaint", "rules": [{ "when": { "field": "flags", "op": "contains", "value": { "node": "P4", "flag": "time_risk" } }, "terminal": "PC" }, { "otherwise": true, "terminal": "PB" }] }, { "label": "已向外部渠道投诉", "value": "external_complaint", "rules": [{ "when": { "field": "flags", "op": "contains", "value": { "node": "P4", "flag": "time_risk" } }, "terminal": "PC" }, { "otherwise": true, "terminal": "PB" }] }, { "label": "已申请劳动仲裁", "value": "arbitration_started", "setFlags": ["arbitration_started"], "terminal": "PD" }] }
  },
  "terminals": {
    "PA": { "id": "PA", "title": "未正式行动", "scopeStatus": "in_scope" },
    "PB": { "id": "PB", "title": "已沟通、投诉或存在签署风险", "scopeStatus": "in_scope" },
    "PC": { "id": "PC", "title": "时效风险", "scopeStatus": "in_scope" },
    "PD": { "id": "PD", "title": "已仲裁", "scopeStatus": "in_scope" },
    "PE": { "id": "PE", "title": "尚无明确措施", "scopeStatus": "in_scope" },
    "PF": { "id": "PF", "title": "孕产关联解除或离职边界", "scopeStatus": "in_scope" },
    "OOS": { "id": "OOS", "title": "不在本项目服务范围", "scopeStatus": "out_of_scope" }
  }
}
